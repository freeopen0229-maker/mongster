<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DomainWorker.cs" />
    <Compile Include="../Assets/Scripts/SliceShared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <Compile Include="../Assets/Scripts/EconomyV2/*.cs" Link="Economy/%(Filename)%(Extension)" />
    <Compile Include="../ServerSources/**/*.cs" Link="Server/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
